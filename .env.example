# Local app settings. `npm run setup:local` creates .env and fills in the encryption key.
# `npm start` and the other app commands load .env automatically.
# `npm run services:up` starts only PostgreSQL and RabbitMQ in Docker.
DITTOLY_MODE=local
DITTOLY_SANDBOX=process
DATABASE_URL=postgres://postgres@127.0.0.1:5433/dittoly
DITTOLY_AMQP_URL=amqp://dittoly:dittoly@127.0.0.1:5672
HOST=127.0.0.1
PORT=8080

# 32 random bytes, base64. Encrypts everyone's credentials; keep it safe and never change it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   or: openssl rand -base64 32
DITTOLY_MASTER_KEY=

# The address people (and phones) open; links, QR codes and sign-in links use it. Without it:
# http://HOST:PORT, or this computer's network address when HOST=0.0.0.0 (npm start -- --host=0.0.0.0).
# DITTOLY_PUBLIC_URL=http://localhost:8080

# Server (compose.server.yml) only: the address people open — Caddy gets its HTTPS certificate for it — and the
# Dittoly release to run. DITTOLY_PUBLIC_URL is set from the domain there; leave it out.
# DITTOLY_DOMAIN=dittoly.example.com
# DITTOLY_VERSION=0.1.0

# Optional shared-mode sign-in with your identity provider (OpenID Connect).
# Register <DITTOLY_PUBLIC_URL>/auth/callback as the redirect URI.
DITTOLY_OIDC_ISSUER=
DITTOLY_OIDC_CLIENT_ID=
DITTOLY_OIDC_CLIENT_SECRET=
# DITTOLY_OIDC_ALLOWED_DOMAINS=example.com

# AI for chat-built modules and Flows: none | anthropic | openai | ollama
# (the Claude and Codex CLIs are for the local install only).
DITTOLY_AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DITTOLY_AI_MODEL=            required for ollama; optional override otherwise
# DITTOLY_OLLAMA_URL=http://ollama.internal:11434

# Internal systems modules may reach on private network addresses (e.g. a self-hosted GitLab).
# Server-wide on purpose: a team cannot widen what the server may reach.
# DITTOLY_INTERNAL_HOSTS=gitlab.corp.example.com,jira.corp.example.com

# Notifications: prefer per-team channels (Teams page: a module action such as Slack
# "post a message", run with the team's own credentials). The settings below are the
# deprecated server-wide fallback, used only for teams that have no channels.
# Slack direct messages (optional): a Slack app's bot token with the scopes
# chat:write, im:write, users:read and users:read.email. Members are found by their sign-in email.
# DITTOLY_SLACK_BOT_TOKEN=xoxb-...
# Teams channel messages (optional): in the channel, Workflows > "Send webhook alerts to a channel",
# then paste the webhook link. Messages name the member they are for.
# DITTOLY_TEAMS_WEBHOOK_URL=https://...
# Commands from Telegram (optional): a bot token from @BotFather. Polled; only one server per bot.
# DITTOLY_TELEGRAM_BOT_TOKEN=123456:ABC...
# Commands from WhatsApp (optional; WhatsApp Business Cloud API). The webhook is https://<server>/channels/whatsapp.
# DITTOLY_WHATSAPP_TOKEN=...
# DITTOLY_WHATSAPP_PHONE_NUMBER_ID=...
# DITTOLY_WHATSAPP_NUMBER=4915112345678
# DITTOLY_WHATSAPP_APP_SECRET=...
# DITTOLY_WHATSAPP_VERIFY_TOKEN=a-long-random-string
# DITTOLY_WHATSAPP_API_VERSION=v26.0
# Email notifications (optional). Emails carry only a sentence and a link.
# How many runs the background worker works on at once (default: 2 shared, 1 local). Notifications, git sync and
# undo have their own lane. Keep it well below the database pool (DITTOLY_DB_POOL_MAX, default 10).
# DITTOLY_RUN_WORKERS=2
# DITTOLY_DRAFT_WORKERS=2
# How many app and fix steps build and test code at once (2 shared, 1 local); more wait their turn.
# DITTOLY_CODE_SANDBOXES=2
# Step images Dittoly pulled are removed after this many hours unused (0: keep them).
# DITTOLY_SANDBOX_IMAGE_TTL_HOURS=24
# New runs are refused (503 server_busy) while this many already wait for a place (default 500).
# DITTOLY_MAX_WAITING_RUNS=500
# Where app and fix steps build, test and run code: on this machine (local, the default) or on a code runner
# machine (remote; start it there with `npm run runner`, see docs/code-runner.md). The token is the runner's
# DITTOLY_RUNNER_TOKEN (openssl rand -base64 32); DITTOLY_RUNNER_CA only for a certificate not publicly trusted.
# DITTOLY_CODE_RUNNER=remote
# DITTOLY_RUNNER_URL=https://runner.internal.example.com:8443
# DITTOLY_RUNNER_TOKEN=
# DITTOLY_RUNNER_CA=/etc/dittoly/runner-ca.pem

# DITTOLY_SMTP_URL=smtps://user:password@smtp.example.com:465
# DITTOLY_EMAIL_FROM=Dittoly <dittoly@example.com>

# For shared mode from source: set DITTOLY_MODE=shared and DITTOLY_SANDBOX=docker,
# then configure OIDC above. The full docker-compose.yml sets its own mode and
# container connection URLs; use HOST=0.0.0.0 for an app running inside Docker.
