{
  "name": "dittoly",
  "version": "0.1.0",
  "description": "Dittoly: orchestrate anything. Super-Modules + Super Flows, approved by people, run with your own access.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "services:up": "docker compose -f docker-compose.local.yml up -d --wait",
    "services:down": "docker compose -f docker-compose.local.yml down",
    "reset": "node --env-file-if-exists=.env scripts/reset.mjs",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "bootstrap": "node --env-file-if-exists=.env --import tsx src/cli/bootstrap.ts",
    "rotate-key": "node --env-file-if-exists=.env --import tsx src/cli/rotate-key.ts",
    "runner": "node --env-file-if-exists=.env.runner --import tsx src/cli/runner.ts",
    "audit:verify-export": "node --import tsx src/cli/verify-audit-export.ts",
    "test": "vitest run",
    "demo:record": "node --import tsx scripts/demo/record.ts",
    "bench:ai": "node --env-file-if-exists=.env --import tsx scripts/bench/ai-model.ts",
    "bench:tasks": "node --env-file-if-exists=.env --import tsx scripts/bench/tasks.ts",
    "test:watch": "vitest",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config web/vite.config.ts",
    "local": "node --env-file-if-exists=.env --import tsx src/local/launcher.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "@modelcontextprotocol/client": "^2.4.0",
    "ajv": "^8.20.0",
    "amqplib": "^2.2.0",
    "cron-parser": "^5.10.2",
    "esbuild": "0.28.2",
    "fastify": "^5.12.7",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "mongodb": "^7.7.0",
    "mqtt": "^5.16.1",
    "mssql": "^12.7.11",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "openai": "^7.43.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "re2js": "^2.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^6.3.0",
    "socks": "^2.8.10",
    "undici": "^8.12.3",
    "unpdf": "2.1.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/mailparser": "3.9.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "aedes": "^1.2.0",
    "oidc-provider": "^9.13.0",
    "playwright-core": "^1.64.1",
    "smtp-server": "^3.21.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "bin": {
    "dittoly": "bin/dittoly.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src/db/migrations",
    "src/runtime",
    "src/export/app-runtime",
    "sandbox-runtime",
    "skills",
    "README.md",
    "LICENSE"
  ]
}
