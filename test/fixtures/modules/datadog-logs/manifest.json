{
  "name": "datadog-logs",
  "version": "1.0.0",
  "title": "Datadog error logs",
  "description": "Searches Datadog logs (read only) around a time, by query, service or trace id, and returns a compact list with trimmed messages and stack traces. Needs a Datadog personal or service access token with the logs_read_data scope: Datadog has no public access.",
  "settings": [
    {
      "id": "site",
      "type": "host",
      "label": "Datadog API host for your site (api.datadoghq.com, api.us3.datadoghq.com, ...)",
      "help": "The Datadog API host of your Datadog site: api. followed by the site's domain.",
      "example": "api.datadoghq.eu",
      "pattern": "**.datadoghq.com",
      "default": "api.datadoghq.com"
    }
  ],
  "hosts": ["{{settings.site}}"],
  "credentials": [
    {
      "id": "datadog_token",
      "service": "datadog",
      "label": "Datadog personal or service access token (logs_read_data)",
      "hosts": ["{{settings.site}}"],
      "placement": { "type": "bearer" },
      "scopes": ["logs_read_data"]
    }
  ],
  "actions": [
    {
      "name": "search_errors",
      "title": "Search error logs",
      "description": "Finds logs (errors by default) in a window around a time, or between from and to, filtered by service, trace id and a Datadog search query. One page per call; pass nextCursor back for the next.",
      "effect": "read",
      "credentials": ["datadog_token"],
      "input": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "maxLength": 1000, "pattern": "^[^\\r\\n]*$" },
          "service": { "type": "string", "pattern": "^[A-Za-z0-9_.:/-]{0,100}$" },
          "traceId": { "type": "string", "pattern": "^[A-Za-z0-9-]{0,64}$" },
          "status": { "type": "string", "enum": ["error", "critical", "warn", "any"], "default": "error" },
          "around": { "type": "string", "maxLength": 40, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]{5,15}(Z|[+-][0-9]{2}:[0-9]{2})$" },
          "windowMinutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 15 },
          "from": { "type": "string", "maxLength": 40, "pattern": "^(now(-[0-9]{1,6}[smhdw])?|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]{5,15}(Z|[+-][0-9]{2}:[0-9]{2}))$" },
          "to": { "type": "string", "maxLength": 40, "pattern": "^(now(-[0-9]{1,6}[smhdw])?|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]{5,15}(Z|[+-][0-9]{2}:[0-9]{2}))$" },
          "indexes": { "type": "array", "maxItems": 10, "items": { "type": "string", "pattern": "^[A-Za-z0-9_*-]{1,100}$" } },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
          "cursor": { "type": "string", "maxLength": 2000, "pattern": "^[A-Za-z0-9_=+/.-]*$" },
          "messageChars": { "type": "integer", "minimum": 100, "maximum": 4000, "default": 500 },
          "stackChars": { "type": "integer", "minimum": 0, "maximum": 8000, "default": 2000 },
          "digestChars": { "type": "integer", "minimum": 500, "maximum": 9500, "default": 8000 }
        },
        "anyOf": [{ "required": ["query"] }, { "required": ["service"] }, { "required": ["traceId"] }],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "logs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "timestamp": { "type": "string" },
                "service": { "type": "string" },
                "status": { "type": "string" },
                "host": { "type": "string" },
                "message": { "type": "string" },
                "errorKind": { "type": "string" },
                "stack": { "type": "string" },
                "traceId": { "type": "string" },
                "version": { "type": "string" },
                "commit": { "type": "string" }
              },
              "required": ["id", "timestamp", "service", "status", "message", "stack", "traceId"]
            }
          },
          "count": { "type": "integer" },
          "nextCursor": { "type": ["string", "null"] },
          "truncated": { "type": "boolean" },
          "partial": { "type": "boolean" },
          "digest": { "type": "string" }
        },
        "required": ["logs", "count", "nextCursor", "truncated", "partial", "digest"]
      }
    }
  ]
}
