{
  "name": "loki-lan",
  "version": "1.0.0",
  "title": "Loki logs (self-hosted, LAN)",
  "description": "Runs a LogQL log query on a self-hosted Grafana Loki, for example one in Docker on your own network, over http or https (read only), and returns a compact list of log lines. Before uploading, set the site setting's pattern and default to your Loki's IP:port; plain http also needs that IP:port in DITTOLY_INSECURE_HTTP_HOSTS, and a private address in DITTOLY_INTERNAL_HOSTS.",
  "settings": [
    {
      "id": "site",
      "type": "host",
      "label": "Loki address on your network (IP:port)",
      "help": "Where Loki answers on your network: its IP address and port (3100 by default), without http://.",
      "example": "192.168.1.20:3100",
      "pattern": "192.168.1.20:3100",
      "default": "192.168.1.20:3100"
    },
    {
      "id": "scheme",
      "type": "text",
      "label": "http or https (http only for an address the admin allows plain http to)",
      "help": "http or https. Use http only for an address the admin allowed plain http to (DITTOLY_INSECURE_HTTP_HOSTS).",
      "example": "http",
      "default": "http"
    },
    {
      "id": "tenant",
      "type": "text",
      "label": "Tenant (X-Scope-OrgID) for a multi-tenant Loki; empty for none",
      "help": "For a multi-tenant Loki, the tenant id sent as X-Scope-OrgID. Leave empty for a single-tenant Loki.",
      "example": "team-a",
      "default": ""
    }
  ],
  "hosts": [
    "{{settings.site}}"
  ],
  "credentials": [
    {
      "id": "loki_login",
      "service": "loki",
      "label": "Loki user and password (user:password), if your Loki has basic auth",
      "hosts": [
        "{{settings.site}}"
      ],
      "placement": {
        "type": "basic"
      },
      "optional": true
    }
  ],
  "actions": [
    {
      "name": "query_logs",
      "title": "Query logs",
      "description": "Runs a LogQL log query (query_range) for a window around a time, or between start and end, and returns the newest lines first, trimmed. Metric queries are refused.",
      "effect": "read",
      "credentials": [
        "loki_login"
      ],
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000,
            "pattern": "^\\{[^\\r\\n]*$"
          },
          "around": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]{5,15}(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "windowMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "default": 15
          },
          "start": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]{5,15}(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "end": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]{5,15}(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "direction": {
            "type": "string",
            "enum": [
              "backward",
              "forward"
            ],
            "default": "backward"
          },
          "lineChars": {
            "type": "integer",
            "minimum": 100,
            "maximum": 4000,
            "default": 1000
          },
          "digestChars": {
            "type": "integer",
            "minimum": 500,
            "maximum": 9500,
            "default": 8000
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timestamp": {
                  "type": "string"
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "line": {
                  "type": "string"
                },
                "traceId": {
                  "type": "string"
                }
              },
              "required": [
                "timestamp",
                "labels",
                "line",
                "traceId"
              ]
            }
          },
          "count": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "digest": {
            "type": "string"
          }
        },
        "required": [
          "lines",
          "count",
          "truncated",
          "digest"
        ]
      }
    }
  ]
}
