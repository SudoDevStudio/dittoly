{
  "name": "gitlab",
  "version": "1.0.0",
  "title": "GitLab",
  "description": "Lists and merges merge requests on gitlab.com.",
  "hosts": ["gitlab.com"],
  "credentials": [
    {
      "id": "gitlab_token",
      "service": "gitlab",
      "label": "GitLab personal access token",
      "hosts": ["gitlab.com"],
      "placement": { "type": "header", "name": "PRIVATE-TOKEN", "prefix": "" },
      "scopes": ["api"]
    }
  ],
  "actions": [
    {
      "name": "list_merge_requests",
      "title": "List merge requests",
      "description": "Lists open merge requests in a project, optionally filtered by label.",
      "effect": "read",
      "credentials": ["gitlab_token"],
      "input": {
        "type": "object",
        "properties": { "project": { "type": "string", "minLength": 1 }, "label": { "type": "string" } },
        "required": ["project"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "mergeRequests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "iid": { "type": "integer" }, "title": { "type": "string" }, "mergeable": { "type": "boolean" } },
              "required": ["iid", "title", "mergeable"]
            }
          }
        },
        "required": ["mergeRequests"]
      }
    },
    {
      "name": "merge_merge_request",
      "title": "Merge a merge request",
      "description": "Merges one merge request.",
      "effect": "write",
      "credentials": ["gitlab_token"],
      "input": {
        "type": "object",
        "properties": { "project": { "type": "string", "minLength": 1 }, "iid": { "type": "integer", "minimum": 1 } },
        "required": ["project", "iid"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": { "iid": { "type": "integer" }, "state": { "type": "string" } },
        "required": ["iid", "state"]
      }
    }
  ]
}
